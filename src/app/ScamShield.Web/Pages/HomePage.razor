@page "/"
@inject IJSRuntime JS
@inject IScamAnalysisService AnalysisService
@inject ScamShieldOptions Options

<PageTitle>ScamShield AI｜截圖防詐分析</PageTitle>

<div class="page-frame">
    <header class="hero">
        <a class="brand" href="/" aria-label="ScamShield AI 首頁">
            <span class="brand-mark" aria-hidden="true">S</span>
            <span>ScamShield AI</span>
        </a>
        <span class="mode-pill" aria-label="目前模式：@ModeDisplay">@ModeDisplay</span>
    </header>

    <main>
        <section class="intro" aria-labelledby="page-title">
            <p class="eyebrow">停一下，再確認</p>
            <h1 id="page-title">可疑截圖，先交給 AI 看看</h1>
            <p class="intro-copy">
                在點擊連結、付款或提供驗證碼前，上傳一張截圖，快速了解風險、原因與下一步建議。
            </p>
            <p id="mode-description" class="mode-notice @(_isMockMode ? "is-demo" : "is-remote")">
                <span class="mode-notice-icon" aria-hidden="true">i</span>
                @if (_isMockMode)
                {
                    <span><strong>展示模式：</strong>分析結果為模擬資料，不會呼叫分析 API。</span>
                }
                else
                {
                    <span><strong>連線模式：</strong>按下分析後，圖片會傳送至目前設定的分析服務。</span>
                }
            </p>
        </section>

        <section class="workspace-grid"
                 aria-label="ScamShield 分析工作區"
                 aria-busy="@(_isBusy ? "true" : "false")">
            <section class="panel upload-panel" aria-labelledby="upload-title">
                <div class="section-heading">
                    <div>
                        <h2 id="upload-title">選擇可疑截圖</h2>
                        <p>選擇一張截圖，再由 AI 整理其中的可疑訊號。</p>
                    </div>
                </div>

                <div class="upload-control">
                    <InputFile id="screenshot-file"
                               class="file-input visually-hidden"
                               accept="image/jpeg,image/png,.jpg,.jpeg,.png"
                               disabled="@_isBusy"
                               aria-label="選擇可疑截圖，僅支援 JPEG 或 PNG"
                               OnChange="HandleFileSelected" />

                    <label class="drop-zone @(_previewDataUrl is not null ? "has-preview" : "is-empty") @(_isBusy ? "is-disabled" : null)"
                           for="screenshot-file"
                           aria-disabled="@(_isBusy ? "true" : "false")">
                        @if (_previewDataUrl is null)
                        {
                            <span class="upload-prompt">
                                <svg class="upload-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                                    <rect x="5" y="8" width="38" height="32" rx="6"></rect>
                                    <circle cx="17" cy="19" r="4"></circle>
                                    <path d="m10 34 9-9 7 7 5-5 7 7"></path>
                                </svg>
                                <strong>選擇一張可疑截圖</strong>
                                <span>支援 JPEG、PNG，最大 10 MiB</span>
                                <span class="button button-secondary upload-action" aria-hidden="true">選擇截圖</span>
                            </span>
                        }
                        else
                        {
                            <img class="image-preview" src="@_previewDataUrl" alt="所選可疑截圖的預覽" />
                            <span class="preview-change" aria-hidden="true">重新選擇截圖</span>
                        }
                    </label>
                </div>

                @if (_selectedImageBytes is { Length: > 0 })
                {
                    <div class="file-row" aria-live="polite">
                        <span class="file-status-icon" aria-hidden="true">✓</span>
                        <span class="file-summary">
                            <span class="file-name" title="@_selectedFileName">@_selectedFileName</span>
                            <span class="file-details">@_selectedFileDetails</span>
                        </span>
                    </div>
                }

                <p id="privacy-hint" class="privacy-note">
                    <span aria-hidden="true">!</span>
                    上傳前可先遮住姓名、帳號與驗證碼等敏感資訊。
                </p>

                <button class="button button-primary analyze-button"
                        disabled="@(!CanAnalyze)"
                        type="button"
                        aria-describedby="mode-description privacy-hint"
                        aria-busy="@(_isBusy ? "true" : "false")"
                        @onclick="AnalyzeAsync">
                    @if (_isBusy)
                    {
                        <span class="button-spinner" aria-hidden="true"></span>
                    }
                    <span>@(_isBusy ? "正在分析…" : "開始 AI 分析")</span>
                </button>

                @if (_isBusy)
                {
                    <div class="status-card loading-card" role="status" aria-live="polite">
                        <span class="spinner" aria-hidden="true"></span>
                        <div>
                            <strong>正在分析可疑訊號…</strong>
                            <span>檢查話術、連結與付款要求</span>
                        </div>
                    </div>
                }

                @if (_errorMessage is not null)
                {
                    <div class="status-card error-card"
                         role="alert"
                         tabindex="-1"
                         @ref="_errorRegion">
                        <div>
                            <strong id="error-title">暫時無法完成分析</strong>
                            <span>@_errorMessage</span>
                        </div>
                        @if (_canRetry)
                        {
                            <button class="button button-error" type="button" @onclick="AnalyzeAsync">
                                再試一次
                            </button>
                        }
                    </div>
                }
            </section>

            <section class="panel result-panel"
                     aria-labelledby="result-title"
                     aria-busy="@(_isBusy ? "true" : "false")"
                     @ref="_resultPanel">
                <div class="section-heading">
                    <div>
                        <h2 id="result-title" class="result-focus-target" tabindex="-1">分析結果</h2>
                        <p>風險、原因與安全行動一次看懂。</p>
                    </div>
                </div>

                @if (_result is null)
                {
                    <div class="empty-result">
                        <svg class="empty-result-icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                            <path d="M30 6 51 14v15c0 12-7 21-21 28C16 50 9 41 9 29V14L30 6Z"></path>
                            <circle cx="36" cy="29" r="8"></circle>
                            <path d="m42 35 8 8"></path>
                        </svg>
                        <strong>分析結果將顯示在這裡</strong>
                        <span>選擇截圖後，我們會整理風險、可疑原因與建議行動。</span>
                    </div>
                }
                else
                {
                    <div class="risk-card @RiskCssClass(_result.RiskLevel)"
                         role="status"
                         aria-label="分析結果：@RiskLevelDisplay(_result.RiskLevel)，風險分數 @_result.RiskScore 分">
                        <div>
                            <span>風險等級</span>
                            <strong>@RiskLevelDisplay(_result.RiskLevel)</strong>
                        </div>
                        <div class="risk-score">
                            <strong>@_result.RiskScore</strong>
                            <span>/ 100</span>
                        </div>
                    </div>

                    <div class="summary-card">
                        <span class="result-label">詐騙類型</span>
                        <strong class="category">@CategoryDisplay(_result.Category)</strong>
                        <span class="result-label">分析摘要</span>
                        <p>@_result.Summary</p>
                    </div>

                    <div class="result-section">
                        <h3>可疑訊號</h3>
                        @if (_result.Signals.Count == 0)
                        {
                            <p class="muted">未觀察到明確的可疑訊號。</p>
                        }
                        else
                        {
                            <ul class="signal-list">
                                @foreach (var signal in _result.Signals)
                                {
                                    <li>
                                        <span class="severity @SeverityCssClass(signal.Severity)">
                                            @SeverityDisplay(signal.Severity)
                                        </span>
                                        <span>@signal.Reason</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <div class="result-section recommendations">
                        <h3>建議行動</h3>
                        <ol>
                            @foreach (var recommendation in _result.Recommendations)
                            {
                                <li>@recommendation</li>
                            }
                        </ol>
                    </div>

                    <button class="button button-secondary full-width" type="button" @onclick="Reset">
                        分析另一張圖片
                    </button>
                }
            </section>
        </section>
    </main>

    <footer class="trust-footer">
        <span class="trust-footer-icon" aria-hidden="true">!</span>
        <p><strong>重要提醒</strong> ScamShield 提供風險提示，不代表最終判定。涉及金錢或帳號時，請改用官方管道再次查證。</p>
    </footer>

</div>

@code {
    private byte[]? _selectedImageBytes;
    private string? _selectedFileName;
    private string? _selectedContentType;
    private string? _previewDataUrl;
    private string _selectedFileDetails = string.Empty;
    private ScamAnalysisResult? _result;
    private string? _errorMessage;
    private bool _canRetry;
    private bool _isBusy;
    private bool _shouldRevealResult;
    private bool _shouldRevealError;
    private ElementReference _resultPanel;
    private ElementReference _errorRegion;

    private bool CanAnalyze => _selectedImageBytes is { Length: > 0 } && !_isBusy;

    private bool _isMockMode => Options.Mode == AnalysisMode.Mock;

    private string ModeDisplay => _isMockMode
        ? "AI 展示模式"
        : "連線分析模式";

    private async Task HandleFileSelected(InputFileChangeEventArgs eventArgs)
    {
        ClearSelection();
        _result = null;
        ClearError();

        try
        {
            var file = eventArgs.File;
            await using var input = file.OpenReadStream(ImageFileValidator.MaximumImageSizeBytes);
            using var output = new MemoryStream();
            await input.CopyToAsync(output);

            var imageBytes = output.ToArray();
            var contentType = ImageFileValidator.DetectContentType(file.Name, imageBytes);

            _selectedImageBytes = imageBytes;
            _selectedFileName = file.Name;
            _selectedContentType = contentType;
            _selectedFileDetails = $"{FormatFileSize(file.Size)} · {contentType.Replace("image/", string.Empty).ToUpperInvariant()}";
            _previewDataUrl = $"data:{contentType};base64,{Convert.ToBase64String(imageBytes)}";
        }
        catch (ImageValidationException exception)
        {
            SetError(exception.Message, retryable: false);
        }
        catch (IOException)
        {
            SetError("圖片大小不可超過 10 MiB。請選擇較小的圖片。", retryable: false);
        }
        catch
        {
            SetError("無法讀取選擇的圖片，請改選其他 JPEG 或 PNG 檔案。", retryable: false);
        }
    }

    private async Task AnalyzeAsync()
    {
        if (_selectedImageBytes is not { Length: > 0 }
            || string.IsNullOrWhiteSpace(_selectedFileName)
            || string.IsNullOrWhiteSpace(_selectedContentType))
        {
            SetError("請先選擇一張 JPEG 或 PNG 圖片。", retryable: false);
            return;
        }

        _isBusy = true;
        _result = null;
        ClearError();

        try
        {
            await using var image = new MemoryStream(_selectedImageBytes, writable: false);
            _result = await AnalysisService.AnalyzeAsync(
                image,
                _selectedFileName,
                _selectedContentType);
            _shouldRevealResult = true;
        }
        catch (ScamAnalysisServiceException exception)
        {
            SetError(exception.Message, exception.Retryable);
        }
        catch (OperationCanceledException)
        {
            SetError("分析已取消。", retryable: true);
        }
        catch
        {
            SetError("目前無法完成分析，請稍後再試。", retryable: true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void Reset()
    {
        ClearSelection();
        _result = null;
        ClearError();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldRevealResult)
        {
            _shouldRevealResult = false;
            await RevealOnMobileAsync(_resultPanel, "#result-title");
        }

        if (_shouldRevealError)
        {
            _shouldRevealError = false;
            await RevealOnMobileAsync(_errorRegion, null);
        }
    }

    private void ClearSelection()
    {
        _selectedImageBytes = null;
        _selectedFileName = null;
        _selectedContentType = null;
        _previewDataUrl = null;
        _selectedFileDetails = string.Empty;
    }

    private void SetError(string message, bool retryable)
    {
        _errorMessage = message;
        _canRetry = retryable && _selectedImageBytes is { Length: > 0 };
        _shouldRevealError = true;
    }

    private void ClearError()
    {
        _errorMessage = null;
        _canRetry = false;
        _shouldRevealError = false;
    }

    private async Task RevealOnMobileAsync(ElementReference element, string? focusSelector)
    {
        try
        {
            await JS.InvokeVoidAsync("scamShieldUi.revealOnMobile", element, focusSelector);
        }
        catch (JSException)
        {
            // Dynamic status and alert regions still announce state if focus management is unavailable.
        }
    }

    private static string FormatFileSize(long byteCount)
    {
        return byteCount >= 1024 * 1024
            ? $"{byteCount / (1024d * 1024d):0.0} MiB"
            : $"{byteCount / 1024d:0.0} KiB";
    }

    private static string RiskLevelDisplay(RiskLevel riskLevel) => riskLevel switch
    {
        RiskLevel.High => "高風險",
        RiskLevel.Medium => "中度風險",
        RiskLevel.Low => "低風險",
        _ => riskLevel.ToString()
    };

    private static string RiskCssClass(RiskLevel riskLevel) => riskLevel switch
    {
        RiskLevel.High => "risk-high",
        RiskLevel.Medium => "risk-medium",
        _ => "risk-low"
    };

    private static string CategoryDisplay(ScamCategory category) => category switch
    {
        ScamCategory.None => "未發現明確類型",
        ScamCategory.Phishing => "網路釣魚",
        ScamCategory.FakeCustomerService => "假客服／假物流",
        ScamCategory.InvestmentScam => "投資詐騙",
        ScamCategory.Impersonation => "冒充身分",
        ScamCategory.AccountTheft => "帳號竊取",
        ScamCategory.Other => "其他詐騙風險",
        ScamCategory.Unknown => "證據不足",
        _ => category.ToString()
    };

    private static string SeverityDisplay(SignalSeverity severity) => severity switch
    {
        SignalSeverity.High => "高",
        SignalSeverity.Medium => "中",
        SignalSeverity.Low => "低",
        _ => severity.ToString()
    };

    private static string SeverityCssClass(SignalSeverity severity) => severity switch
    {
        SignalSeverity.High => "severity-high",
        SignalSeverity.Medium => "severity-medium",
        _ => "severity-low"
    };
}
