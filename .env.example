# Copy to untracked .env.local. Empty values are intentionally NOT working credentials.
# All settings are read on the server; never use NEXT_PUBLIC_* for secrets.
# Platform environment changes require a new deployment. Only the Redis control
# key below takes effect for new requests without rebuilding/redeploying.
ANALYSIS_MODE=mock
# Both remote mode AND true are needed; false is the safe default.
ANALYSIS_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini-2025-04-14
AI_API_KEY=
# Integer milliseconds: defaults and maxima 20s Provider / 25s application.
# Provider + 2000 <= application; route maxDuration remains 30s. No retries.
AI_TIMEOUT_MS=20000
ANALYSIS_TIMEOUT_MS=25000
PROMPT_VERSION=scam-analysis-v1

# Feedback: optional public values, exposed only through an allowlisted config.
# HTTPS responder URL only: docs.google.com/forms/.../viewform or forms.gle/...
# Leave empty until an actual form is published and tested without Google login.
FEEDBACK_FORM_URL=
# Real pre-fill field names from Google Forms: entry.<digits>. Never guess IDs.
# Missing entries still open the ordinary form. Short forms.gle links never prefill.
FEEDBACK_FORM_ENTRY_REQUEST_ID=
FEEDBACK_FORM_ENTRY_BUILD=
FEEDBACK_FORM_ENTRY_TYPE=
# Optional feedback mailbox; no headers/query/body. Empty hides these backup actions.
# The public privacy/deletion contact and 90-day feedback policy live in lib/privacy.ts;
# they are public product information, not secrets or environment requirements.
FEEDBACK_CONTACT_EMAIL=
# Nonsecret short build/version identifier; fallback: VERCEL_GIT_COMMIT_SHA.
APP_BUILD_ID=

# Required only when ANALYSIS_ENABLED=true. No memory fallback on errors.
# Use distinct Redis resources/credentials for Preview and Production where possible.
# REST URL must be HTTPS on the expected *.upstash.io host. Do not include a path/token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Explicit deployment identity: development | preview | production.
# On Vercel this must match the trusted VERCEL_ENV; do not spoof VERCEL variables locally.
QUOTA_ENVIRONMENT=development
# Identifiers: lowercase letter followed by lowercase letters/digits/hyphens, max 48 chars.
# Effective prefix contains both environment and namespace; this is NOT credential isolation.
QUOTA_NAMESPACE=scamshield
# Server secret: at least 32 bytes of independently generated random material.
QUOTA_IP_HMAC_SECRET=
# none (default fail closed without explicit dev IP), or vercel on actual Vercel only.
# Vercel source: x-vercel-forwarded-for; arbitrary X-Forwarded-For is not trusted.
QUOTA_TRUST_PROXY=none
# Development-only explicit IP override; omit on Preview/Production (where it is rejected).
# Set only for an explicitly intended local development test; no universal fallback.
QUOTA_DEV_IP=

# Beta starting policy; all server-side. Short window is fixed at 60,000 ms.
QUOTA_WINDOW_LIMIT=3
QUOTA_IP_DAILY_LIMIT=10
QUOTA_GLOBAL_DAILY_LIMIT=200
QUOTA_CONCURRENCY_LIMIT=3
# Daily reset is fixed to Asia/Taipei 00:00 using Redis TIME, not browser date.
# Attempts are charged once admitted; cancellation/failure does not refund daily quota.
QUOTA_REDIS_TIMEOUT_MS=1000
# 45,000–120,000 ms; covers the 25s API deadline plus a safety margin.
QUOTA_LEASE_MS=60000
# Exact control key: {scamshield:<environment>:<namespace>}:control:<suffix>
# Default development example: {scamshield:development:scamshield}:control:analysis-enabled
# No TTL on the control key. ONLY the exact value enabled permits admission.
# Missing, disabled, invalid or unreadable is fail-closed. Initialize manually in
# the explicitly targeted isolated environment; this repository never auto-enables it.
QUOTA_CONTROL_KEY_SUFFIX=analysis-enabled
