{
  "name": "scamshield-ai",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "node scripts/test-http.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "eval:ai": "node --conditions=react-server --import tsx scripts/evaluate.ts",
    "verify:bundle": "node scripts/check-bundle.mjs",
    "eval:prepare": "node --import tsx scripts/prepare-evaluation.ts",
    "smoke:preview": "node --conditions=react-server --import tsx scripts/preview-smoke.ts"
  },
  "dependencies": {
    "bcp-47": "2.1.1",
    "content-disposition": "3.0.0",
    "content-type": "3.0.0",
    "next": "16.3.4",
    "openai": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/content-disposition": "0.5.9",
    "@types/content-type": "1.1.9",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "type": "module",
  "packageManager": "npm@12.0.2"
}
